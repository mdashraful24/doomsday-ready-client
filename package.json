{
	"name": "cine-quest-client",
	"version": "1.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "tsc --noEmit && vite build",
		"preview": "vite preview",
		"typecheck": "tsc --noEmit",
		"format:check": "bunx @biomejs/biome format ./src",
		"format:fix": "bunx @biomejs/biome format --write ./src",
		"lint:check": "bunx @biomejs/biome lint ./src",
		"lint:fix": "bunx @biomejs/biome lint --write ./src"
	},
	"dependencies": {
		"react": "^19.2.0",
		"react-dom": "^19.2.0"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.15",
		"@tailwindcss/vite": "^4.3.5",
		"@types/react": "^19.2.0",
		"@types/react-dom": "^19.2.0",
		"@vitejs/plugin-react": "^5.0.0",
		"tailwindcss": "^4.3.5",
		"typescript": "^7.0.2",
		"vite": "^7.1.0"
	}
}
