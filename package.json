{
	"name": "doomsday-ready-client",
	"version": "1.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "tsc --noEmit && vite build",
		"preview": "vite preview",
		"typecheck": "tsc --noEmit",
		"format:check": "bunx @biomejs/biome format ./src",
		"format:fix": "bunx @biomejs/biome format --write ./src",
		"lint:check": "bunx @biomejs/biome lint ./src",
		"lint:fix": "bunx @biomejs/biome lint --write ./src"
	},
	"dependencies": {
		"lucide-react": "^1.77.0",
		"react": "^19.2.0",
		"react-dom": "^19.2.0",
		"react-router-dom": "^7.18.6",
		"sonner": "^2.0.8"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.15",
		"@tailwindcss/vite": "^4.3.5",
		"@types/react": "^19.2.0",
		"@types/react-dom": "^19.2.0",
		"@vitejs/plugin-react": "^5.0.0",
		"tailwindcss": "^4.3.5",
		"typescript": "^7.0.2",
		"vite": "^7.1.0"
	}
}
